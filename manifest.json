{
  "manifest_version": 3,
  "name": "Teams++",
  "short_name": "Teams++",
  "version": "1.0.3",
  "description": "Compact post cards for Microsoft Teams channels — every post as a headline, one click to open.",
  "minimum_chrome_version": "116",
  "author": "Jonathan Kung",
  "homepage_url": "https://github.com/jcykung/teamsplusplus",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://teams.live.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Teams++",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
